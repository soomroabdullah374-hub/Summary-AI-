# Groq (gsk_...) or xAI (xai-...) key. Server-side only: never prefix it with NEXT_PUBLIC_.
GROK_API_KEY=gsk_your_groq_api_key

# Optional overrides
# LLM_MODEL=openai/gpt-oss-120b      # default for gsk_ keys; grok-4-latest for xai- keys
# LLM_INPUT_CHARS=12000              # longest source sent in one request; raise on paid Groq tiers

# Optional: Supabase history (database "summary", ap-south-1). Leave blank to keep history in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
